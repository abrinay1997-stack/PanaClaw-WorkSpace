{
  "name": "cotizador-panaclaw",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cotizador interno de PanaClaw: arma la propuesta desde datos/precios.json y genera el PDF y el mensaje de WhatsApp.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
